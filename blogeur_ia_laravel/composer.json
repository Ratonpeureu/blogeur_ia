{
    "name": "votre-vendor/blogueur-ia",
    "description": "Module de blog éditorial autonome piloté par IA — rédaction, illustration, backlinks SEO réels, publication.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/queue": "^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.8",
        "league/commonmark": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "BlogueurIa\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BlogueurIa\\BlogueurIaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}