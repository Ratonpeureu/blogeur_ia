; Copier en blogueur_ia.conf et adapter — seule source de vérité pour le
; comportement éditorial, la marque, les catégories, le stockage.
; Les secrets restent dans .env.

[brand]
name = Mon Entreprise
base_url = https://exemple.com
author_default = Équipe Éditoriale
persona_name = Jean Dupont
persona_bio = professionnel du secteur, écrivant à la première personne

[style]
secteur = votre secteur d'activité
min_words = 900
max_words = 1600
temperature_redaction = 0.9
temperature_reecriture = 0.7
interdits = en somme,il est essentiel de noter,de plus,par ailleurs,en conclusion,à l'ère du digital

[promo_guard]
enabled = true
brand_trigger_keywords = mon entreprise,notre logiciel,notre plateforme,notre solution
mentions_interdites = chez mon entreprise,notre logiciel,notre plateforme,notre solution,intégré à notre,nous avons développé

[categories]
ids_labels = guide:Guide pratique,actualite:Actualité,analyse-marche:Analyse de marché,reglementation:Réglementation,temoignage:Témoignage,produit:Produit & nouveautés
categorie_produit_id = produit
categorie_defaut = guide

[mots_cles_seo]
pool = mot-cle-1,mot-cle-2,mot-cle-3

[fiche_technique]
path = fiche_technique_produit.yaml

[storage]
dir = ./uploads/blog
base_url = https://exemple.com/uploads/blog
max_size_mb = 6

[serper]
gl = sn
hl = fr

[llm]
provider = anthropic
model = claude-sonnet-4-5

[queue]
; nom de la queue BullMQ — à référencer côté worker de l'app hôte si besoin
name = blogueur-ia-articles